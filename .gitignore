# Large / re-downloadable data (fetch via src/download_*.sh)
data/
*.csv
*.txt
!requirements*.txt

# Large prediction sidecars + logs (results JSONs are kept as the evidence)
results/**/*.preds.npz
results/logs/
results/.overnight/
results/_evalcheck/

# Python / env
__pycache__/
*.pyc
.ipynb_checkpoints/
qml-env/
*.log

# Scratch / diagnostic scripts (not part of the released pipeline)
src/_*.py
src/_*.sh
paper/_*.py
paper/_*.sh

# LaTeX build artifacts (manuscript.pdf is kept; the rest regenerate)
paper/arxiv_build/
paper/arxiv.zip
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/page*.png

# OS
.DS_Store
Thumbs.db
paper/chk*.png
