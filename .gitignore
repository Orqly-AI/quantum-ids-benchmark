# Large / re-downloadable data (fetch via src/download_*.sh)
data/
*.csv
*.txt
!requirements*.txt

# Large prediction sidecars + logs (results JSONs are kept as the evidence)
results/**/*.preds.npz
results/logs/
results/.overnight/
results/_evalcheck/

# Python / env
__pycache__/
*.pyc
.ipynb_checkpoints/
qml-env/
*.log

# Scratch / diagnostic scripts (not part of the released pipeline)
src/_*.py
src/_*.sh
paper/_*.py
paper/_*.sh

# LaTeX build artifacts (manuscript.pdf is kept; the rest regenerate)
paper/arxiv_build/
paper/arxiv.zip
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/page*.png

# OS
.DS_Store
Thumbs.db
paper/chk*.png

# LaTeX build artefacts in subdirectories (paper/arxiv, paper/submission)
paper/**/*.aux
paper/**/*.out
paper/**/*.log
paper/**/*.blg

# The paper build pipeline is part of the released artefact (tables are generated from JSON)
!paper/_gen_tables*.py
!paper/_sync_figs.py
!paper/_sync_arxiv.py
!paper/_submission_meta.py
!paper/_assemble_kernel.py
!paper/_assemble_hardware.py
!paper/_assemble_v3.py
!paper/_refresh_tables.py
!paper/_arxiv_meta.py
!paper/_assemble_v4.py
!paper/_gen_fig6.py
!paper/_build_all.sh
!paper/_render_png.sh
!paper/_check_build.sh
!paper/_strip_comments.py
!paper/_clean_bib.py
!paper/_bibaudit.py
!paper/_bibresolve.py
!paper/_citecheck.py

# editing backups
paper/*.bak_*
